{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarTide",
  "version": "0.1.0",
  "identifier": "dev.startide.app",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "StarTide",
        "label": "main",
        "width": 1080,
        "height": 660,
        "minWidth": 920,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#1e1e1e"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
